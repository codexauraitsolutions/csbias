PORT=4000
DATABASE_URL="mysql://user:password@localhost:3306/csbias"
JWT_SECRET="change-me-to-a-long-random-string"
CLIENT_ORIGIN="http://localhost:5173"
ADMIN_ORIGIN="http://localhost:5174"
UPLOADS_DIR="./uploads"
# Public origin the server is reachable at — used to build absolute /uploads
# URLs embedded inside rich content (PDF embeds, inline images), since those
# are rendered on whatever origin is viewing the page, not the API's own.
PUBLIC_URL="http://localhost:4000"

# Only needed once, when running the WordPress data migration script.
# Point this at a MySQL instance where the WP .sql dump has been imported (a staging DB, not the app's own DATABASE_URL).
WP_DATABASE_URL="mysql://user:password@localhost:3306/csbias_wp_staging"
